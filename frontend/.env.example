# Optional completion API proxy. Must be a server you control that returns
# { "suggestions": [{ "label": "map", "insertText": "map", "detail": "..." }] }.
# Never put OpenAI/provider API keys in REACT_APP_* variables.
REACT_APP_COMPLETION_API_URL=

# Optional language-server WebSocket gateway (must speak JSON-RPC/LSP over WebSocket).
# Deploy a compatible server/gateway separately; secure it with TLS and origin/auth checks.
REACT_APP_LSP_WEBSOCKET_URL=
